#!/bin/bash
# NeuroStrata pre-commit hook — scaffolded by neurostrata-bootstrap.
#
# Records the files/prefixes touched by this commit into `.NeuroStrata/session_queries.json`
# and stamps `graph_queried` on the active in_progress task for the namespace.
# Works across any repository layout (src/, pkg/, cmd/, apps/, packages/, scripts/, root files).
#
# Install with:  neurostrata-mcp hooks install

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# Linked worktrees (`git worktree add`, `.claude/worktrees/...`) record into
# ONE ledger: the main checkout's. The common git dir of a linked worktree is
# the main checkout's `.git`; for the main checkout itself git prints `.git`,
# relative to the top level, where hooks run. A common dir not named `.git`
# (`--separate-git-dir`, a bare repository) keeps the worktree's own ledger.
# A ledger the worktree already has (a lookup sent with the worktree as its
# project root) is read too.
MAIN_ROOT="$ROOT"
COMMON=$(git rev-parse --git-common-dir 2>/dev/null)
case "$COMMON" in
    /*|[A-Za-z]:*) ;;
    "") ;;
    *) COMMON="$ROOT/$COMMON" ;;
esac
case "$COMMON" in
    */.git) MAIN_ROOT="${COMMON%/.git}" ;;
esac
LEDGER="$MAIN_ROOT/.NeuroStrata/session_queries.json"
OWN_LEDGER=""
if [ "$MAIN_ROOT" != "$ROOT" ] && [ -f "$ROOT/.NeuroStrata/session_queries.json" ]; then
    OWN_LEDGER="$ROOT/.NeuroStrata/session_queries.json"
fi
# The namespace a ledger names: the shared one first, else the worktree's own
# (only the worktree has looked anything up yet), else the folder name.
NAMESPACE=""
for NS_LEDGER in "$LEDGER" "$OWN_LEDGER"; do
    if [ -z "$NAMESPACE" ] && [ -n "$NS_LEDGER" ] && [ -f "$NS_LEDGER" ]; then
        NAMESPACE=$(grep -o '"namespace"[[:space:]]*:[[:space:]]*"[^"]*"' "$NS_LEDGER" | head -n1 | sed 's/.*"namespace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    fi
done
if [ -z "$NAMESPACE" ]; then
    NAMESPACE=$(basename "$MAIN_ROOT")
fi

# Windows roots (`C:/...`) compare case-insensitively, like the file system.
# Only ASCII letters are folded, the same way in bash, node and python, so a
# file name spelled identically on both sides always matches.
FOLD=0
case "$ROOT" in
    [A-Za-z]:*) FOLD=1 ;;
esac
fold_case() {
    if [ "$FOLD" = "1" ]; then
        printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z'
    else
        printf '%s' "$1"
    fi
}

# ── Collect staged file paths (excluding .NeuroStrata/ internal files) ───────
StagedFiles=()
while IFS= read -r -d '' file; do
    case "$file" in
        .NeuroStrata/*|"") ;;
        *) StagedFiles+=("$file") ;;
    esac
done < <(git diff --name-only -z --cached 2>/dev/null)
if [ "${#StagedFiles[@]}" -eq 0 ]; then
    while IFS= read -r -d '' file; do
        case "$file" in
            .NeuroStrata/*|"") ;;
            *) StagedFiles+=("$file") ;;
        esac
    done < <(git diff --name-only -z 2>/dev/null)
fi

# ── Path normalization for ledger matching ─────────────────────────────────
# $file from git diff is repo-relative (e.g. `pkg/auth/handler.go`). A ledger
# entry may carry `path` (already project-relative, written by newer daemons;
# preferred), or only the raw `query`: `"$ROOT/$file"` or the main checkout's
# absolute path, with `/` or `\`, `\\?\` or Git Bash `/c/` prefixes and any
# drive-letter case on Windows, `"./$file"`, or the bare `"$file"`. All of them
# are reduced to the repo-relative form below.
normalize_rel_path() {
    local p="$1"
    p="${p#"$ROOT"/}"
    while [ "${p#./}" != "$p" ]; do
        p="${p#./}"
    done
    p="${p%/}"
    printf '%s' "$p"
}

# Dump decoded, normalized paths (one per line) of the ledger file "$1" using
# node or python3. Empty if that ledger is missing or neither runtime is
# available.
dump_ledger_paths() {
    if [ ! -f "$1" ]; then
        return 0
    fi
    ( LEDGER="$1"; dump_ledger_file )
}
dump_ledger_file() {
    export LEDGER ROOT MAIN_ROOT FOLD
    if command -v node >/dev/null 2>&1; then
        node -e '
          const fs = require("fs");
          const ledger = process.env.LEDGER;
          const win = process.env.FOLD === "1";
          const fold = (s) => (win ? s.replace(/[A-Z]/g, (c) => c.toLowerCase()) : s);
          // C:\x | C:/x | \\?\C:\x | /c/x (Windows only) -> C:/x ; no trailing /
          const normAbs = (p) => {
            p = p.replace(/\\/g, "/").replace(/^\/\/[?.]\//, "");
            const m = win ? /^\/([A-Za-z])(\/.*)?$/.exec(p) : null;
            if (m) p = m[1] + ":" + (m[2] || "/");
            return p.length > 1 ? p.replace(/\/+$/, "") : p;
          };
          const roots = [process.env.ROOT, process.env.MAIN_ROOT].filter(Boolean).map(normAbs);
          let parsed;
          try { parsed = JSON.parse(fs.readFileSync(ledger, "utf8")); } catch { process.exit(0); }
          const queries = Array.isArray(parsed) ? parsed : (parsed && Array.isArray(parsed.queries) ? parsed.queries : []);
          const out = new Set();
          const norm = (raw) => {
            if (typeof raw !== "string" || !raw) return;
            let p = normAbs(raw);
            for (const r of roots) {
              if (fold(p) === fold(r)) return;
              if (fold(p).startsWith(fold(r) + "/")) { p = p.slice(r.length + 1); break; }
            }
            if (/^[A-Za-z]:\//.test(p) || p.startsWith("/")) return; // another project
            while (p.startsWith("./")) p = p.slice(2);
            if (p) out.add(fold(p));
          };
          for (const q of queries) {
            if (!q || typeof q !== "object") continue;
            if (typeof q.path === "string" && q.path) norm(q.path); else norm(q.query);
            for (const k of ["domains", "governed_prefixes"]) {
              if (Array.isArray(q[k])) q[k].forEach(norm);
            }
          }
          for (const p of out) process.stdout.write(p + "\n");
        ' 2>/dev/null || true
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, os, re, sys
# Bash compares these lines byte for byte (grep -x): write UTF-8 and plain
# newlines even where a Windows Python defaults to the ANSI code page and CRLF.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", newline="\n")
ledger = os.environ["LEDGER"]
win = os.environ.get("FOLD") == "1"
def fold(s):
    return re.sub(r"[A-Z]", lambda m: m.group(0).lower(), s) if win else s
def norm_abs(p):
    p = re.sub(r"^//[?.]/", "", p.replace("\\", "/"))
    m = re.match(r"^/([A-Za-z])(/.*)?$", p) if win else None
    if m:
        p = m.group(1) + ":" + (m.group(2) or "/")
    return p.rstrip("/") if len(p) > 1 else p
roots = [norm_abs(r) for r in (os.environ.get("ROOT"), os.environ.get("MAIN_ROOT")) if r]
try:
    with open(ledger, encoding="utf-8") as f:
        parsed = json.load(f)
except Exception:
    sys.exit(0)
queries = parsed if isinstance(parsed, list) else (parsed.get("queries") if isinstance(parsed, dict) else [])
if not isinstance(queries, list):
    queries = []
out = set()
def norm(raw):
    if not isinstance(raw, str) or not raw:
        return
    p = norm_abs(raw)
    for r in roots:
        if fold(p) == fold(r):
            return
        if fold(p).startswith(fold(r) + "/"):
            p = p[len(r) + 1:]
            break
    if re.match(r"^[A-Za-z]:/", p) or p.startswith("/"):
        return
    while p.startswith("./"):
        p = p[2:]
    if p:
        out.add(fold(p))
for q in queries:
    if not isinstance(q, dict):
        continue
    if isinstance(q.get("path"), str) and q.get("path"):
        norm(q.get("path"))
    else:
        norm(q.get("query"))
    for k in ("domains", "governed_prefixes"):
        v = q.get(k)
        if isinstance(v, list):
            for item in v:
                norm(item)
for p in out:
    sys.stdout.write(p + "\n")
' 2>/dev/null || true
    fi
}

LEDGER_PATHS=$(dump_ledger_paths "$LEDGER"; [ -n "$OWN_LEDGER" ] && dump_ledger_paths "$OWN_LEDGER")

# The ledgers this hook reads: the shared one, and the worktree's own if any.
any_ledger() {
    [ -f "$LEDGER" ] || [ -n "$OWN_LEDGER" ]
}

# Raw-text fallback when neither node nor python3 is available.
ledger_grep() {
    local needle="$1" f
    for f in "$LEDGER" "$OWN_LEDGER"; do
        [ -n "$f" ] && [ -f "$f" ] && grep -qF "$needle" "$f" 2>/dev/null && return 0
    done
    return 1
}

ledger_has_file() {
    local rel="$1"
    if [ -n "$LEDGER_PATHS" ]; then
        printf '%s\n' "$LEDGER_PATHS" | grep -qxF "$(fold_case "$rel")"
        return $?
    fi
    any_ledger || return 1
    ledger_grep "\"$rel\"" \
        || ledger_grep "\"./$rel\"" \
        || ledger_grep "\"$ROOT/$rel\"" \
        || ledger_grep "\"$MAIN_ROOT/$rel\""
}

ledger_has_dir() {
    local rel_dir="${1%/}"
    if [ -n "$LEDGER_PATHS" ]; then
        printf '%s\n' "$LEDGER_PATHS" | grep -qxF "$(fold_case "$rel_dir")"
        return $?
    fi
    any_ledger || return 1
    ledger_grep "\"$rel_dir/\"" \
        || ledger_grep "\"./$rel_dir/\"" \
        || ledger_grep "\"$ROOT/$rel_dir/\"" \
        || ledger_grep "\"$MAIN_ROOT/$rel_dir/\"" \
        || ledger_grep "\"$rel_dir\""
}

# ── Check each staged file / ancestor dir-prefix against session_queries.json ──
for raw_file in "${StagedFiles[@]}"; do
    file=$(normalize_rel_path "$raw_file")
    [ -z "$file" ] && continue
    matched=0
    if any_ledger; then
        if ledger_has_file "$file"; then
            matched=1
        else
            # Walk ancestor directories of $file; only match if the exact
            # ancestor path was recorded in $LEDGER (not widened to top-level).
            anc=$(dirname "$file")
            while [ "$anc" != "." ] && [ "$anc" != "/" ] && [ -n "$anc" ]; do
                if ledger_has_dir "$anc"; then
                    matched=1
                    break
                fi
                anc=$(dirname "$anc")
            done
        fi
    fi
    if [ "$matched" -eq 0 ]; then
        echo "warning: file '$file' has no recorded NeuroStrata graph/memory lookup in this session" >&2
        echo "  → call: neurostrata_memories_for_file --namespace $NAMESPACE --path \"$file\"" >&2
    fi
done

# ── Write the query ledger (non-blocking, always writes) ─────────────────────
mkdir -p "$(dirname "$LEDGER")"

# Linked worktrees share this ledger, so two commits at once would both read,
# add and write it, and one would lose the other's entries. An atomic `mkdir`
# of a lock directory next to the ledger serializes the read-modify-write for
# every writer below (node, python, awk), on Windows and POSIX alike. A lock
# older than 30 s is left over from a killed hook and is taken over. After
# about 5 s of waiting the hook writes anyway, with a warning: it only warns,
# so it must never block a commit.
LEDGER_LOCK="$LEDGER.lock"
LEDGER_LOCKED=0
release_ledger_lock() {
    if [ "$LEDGER_LOCKED" = "1" ]; then
        rm -rf "$LEDGER_LOCK" 2>/dev/null
        LEDGER_LOCKED=0
    fi
}
acquire_ledger_lock() {
    local tries=0 since
    while ! mkdir "$LEDGER_LOCK" 2>/dev/null; do
        since=$(cat "$LEDGER_LOCK/since" 2>/dev/null)
        case "$since" in
            ''|*[!0-9]*) ;;
            *)
                if [ $(( $(date +%s) - since )) -gt 30 ]; then
                    rm -rf "$LEDGER_LOCK" 2>/dev/null
                    continue
                fi
                ;;
        esac
        tries=$((tries + 1))
        if [ "$tries" -ge 50 ]; then
            echo "warning: NeuroStrata ledger lock $LEDGER_LOCK is held; writing the ledger without it" >&2
            return 1
        fi
        sleep 0.1
    done
    date +%s > "$LEDGER_LOCK/since" 2>/dev/null
    LEDGER_LOCKED=1
    trap release_ledger_lock EXIT
}
acquire_ledger_lock

if [ ! -f "$LEDGER" ]; then
    printf '{\n  "namespace": "%s",\n  "queries": [\n  ]\n}\n' "$NAMESPACE" > "$LEDGER"
fi

MissingFiles=()
for raw_file in "${StagedFiles[@]}"; do
    file=$(normalize_rel_path "$raw_file")
    [ -z "$file" ] && continue
    if [ -n "$LEDGER_PATHS" ]; then
        if printf '%s\n' "$LEDGER_PATHS" | grep -qxF "$(fold_case "$file")"; then
            continue
        fi
    fi
    if ledger_has_file "$file"; then
        continue
    fi
    MissingFiles+=("$file")
done

if [ "${#MissingFiles[@]}" -gt 0 ]; then
    TS=$(date +%s)
    export LEDGER NAMESPACE TS
    if command -v node >/dev/null 2>&1; then
        printf '%s\n' "${MissingFiles[@]}" | node -e '
          const fs = require("fs");
          const ledger = process.env.LEDGER;
          const ns = process.env.NAMESPACE;
          const ts = parseInt(process.env.TS, 10) || 0;
          const files = fs.readFileSync(0, "utf8").split("\n").filter(Boolean);
          let doc = { namespace: ns, queries: [] };
          try {
            const raw = fs.readFileSync(ledger, "utf8");
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              doc = { namespace: ns, queries: parsed };
            } else if (parsed && typeof parsed === "object") {
              doc = parsed;
            }
          } catch {}
          if (typeof doc.namespace !== "string" || !doc.namespace) doc.namespace = ns;
          if (!Array.isArray(doc.queries)) doc.queries = [];
          const have = new Set(doc.queries.filter((q) => q && typeof q === "object" && typeof q.query === "string").map((q) => q.query));
          for (const file of files) {
            if (have.has(file)) continue;
            have.add(file);
            doc.queries.push({ ts, tool: "pre-commit", query: file, domains: [file], returned_ids: [], governed_prefixes: [file] });
          }
          fs.writeFileSync(ledger, JSON.stringify(doc, null, 2) + "\n");
        ' 2>/dev/null || true
    elif command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "${MissingFiles[@]}" | python3 -c '
import json, os, sys
ledger = os.environ["LEDGER"]
ns = os.environ["NAMESPACE"]
ts = int(os.environ.get("TS", "0") or "0")
files = [line.rstrip("\n") for line in sys.stdin if line.strip()]
try:
    with open(ledger) as f:
        parsed = json.load(f)
except Exception:
    parsed = {}
if isinstance(parsed, list):
    doc = {"namespace": ns, "queries": parsed}
elif isinstance(parsed, dict):
    doc = parsed
else:
    doc = {"namespace": ns, "queries": []}
if not isinstance(doc.get("namespace"), str) or not doc.get("namespace"):
    doc["namespace"] = ns
if not isinstance(doc.get("queries"), list):
    doc["queries"] = []
have = {q.get("query") for q in doc["queries"] if isinstance(q, dict)}
for file in files:
    if file in have:
        continue
    have.add(file)
    doc["queries"].append({"ts": ts, "tool": "pre-commit", "query": file, "domains": [file], "returned_ids": [], "governed_prefixes": [file]})
with open(ledger, "w") as f:
    json.dump(doc, f, indent=2, ensure_ascii=False)
    f.write("\n")
' 2>/dev/null || true
    else
        # awk fallback: still ONE invocation. Read missing files from a temp list.
        FILELIST=$(mktemp)
        printf '%s\n' "${MissingFiles[@]}" > "$FILELIST"
        export FILELIST
        TMP=$(mktemp)
        awk '
          function json_escape(s,    i, n, c, out) {
            out = ""
            n = length(s)
            for (i = 1; i <= n; i++) {
              c = substr(s, i, 1)
              if (c == "\\") out = out "\\\\"
              else if (c == "\"") out = out "\\\""
              else if (c == "\t") out = out "\\t"
              else if (c == "\r") out = out "\\r"
              else if (c == "\n") out = out "\\n"
              else if (c == "\f") out = out "\\f"
              else if (c == "\b") out = out "\\b"
              else out = out c
            }
            return out
          }
          function entry_str(file, comma,    s) {
            s = "    {\n"
            s = s "      \"ts\": " ts ",\n"
            s = s "      \"tool\": \"pre-commit\",\n"
            s = s "      \"query\": \"" file "\",\n"
            s = s "      \"domains\": [\"" file "\"],\n"
            s = s "      \"returned_ids\": [],\n"
            s = s "      \"governed_prefixes\": [\"" file "\"]\n"
            s = s (comma ? "    }," : "    }")
            return s
          }
          BEGIN {
            ns = json_escape(ENVIRON["NAMESPACE"])
            ts = ENVIRON["TS"] + 0
            nfiles = 0
            while ((getline line < ENVIRON["FILELIST"]) > 0) {
              if (line != "") {
                nfiles++
                files[nfiles] = json_escape(line)
              }
            }
            close(ENVIRON["FILELIST"])
            doc = ""
          }
          {
            doc = (NR == 1 ? $0 : doc "\n" $0)
          }
          END {
            nent = 0
            for (i = 1; i <= nfiles; i++) {
              if (index(doc, "\"" files[i] "\"") > 0) continue
              nent++
              newf[nent] = files[i]
            }
            trimmed = doc
            sub(/^[[:space:]]+/, "", trimmed)
            sub(/[[:space:]]+$/, "", trimmed)
            if (substr(trimmed, 1, 1) == "[" && substr(trimmed, length(trimmed), 1) == "]") {
              inner = substr(trimmed, 2, length(trimmed) - 2)
              sub(/^[[:space:]]*\n?/, "", inner)
              sub(/\n?[[:space:]]*$/, "", inner)
              print "{"
              print "  \"namespace\": \"" ns "\","
              print "  \"queries\": ["
              if (nent == 0) {
                if (inner != "") print inner
              } else if (inner == "") {
                for (i = 1; i <= nent; i++) print entry_str(newf[i], i < nent)
              } else {
                for (i = 1; i <= nent; i++) print entry_str(newf[i], 1)
                print inner
              }
              print "  ]"
              print "}"
              exit
            }
            if (nent == 0) {
              print doc
              exit
            }
            if (match(doc, /"queries"[[:space:]]*:[[:space:]]*\[/)) {
              open_idx = RSTART + RLENGTH - 1
              prefix = substr(doc, 1, open_idx)
              rest = substr(doc, open_idx + 1)
              if (match(rest, /^[[:space:]]*\]/)) {
                close_part = substr(rest, RSTART + RLENGTH - 1)
                print prefix
                for (i = 1; i <= nent; i++) print entry_str(newf[i], i < nent)
                print "  " close_part
                exit
              } else {
                sub(/^[[:space:]]*\n?/, "", rest)
                print prefix
                for (i = 1; i <= nent; i++) print entry_str(newf[i], 1)
                print "    " rest
                exit
              }
            }
            print "{"
            print "  \"namespace\": \"" ns "\","
            print "  \"queries\": ["
            for (i = 1; i <= nent; i++) print entry_str(newf[i], i < nent)
            print "  ]"
            print "}"
          }
        ' "$LEDGER" > "$TMP" 2>/dev/null && mv "$TMP" "$LEDGER" || rm -f "$TMP"
        rm -f "$FILELIST"
    fi
fi

exit 0
